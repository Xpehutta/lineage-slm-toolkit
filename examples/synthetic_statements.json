  {
    "id": "s001",
    "sql": "INSERT INTO mart.daily_sales SELECT o.order_id, c.customer_name, o.amount FROM raw.orders o JOIN raw.customers c ON o.customer_id = c.customer_id",
    "schema": ["mart.daily_sales", "raw.orders", "raw.customers"],
    "edges": [
      {"target": {"table": "mart.daily_sales", "column": "order_id"}, "sources": [{"table": "raw.orders", "column": "order_id"}]},
      {"target": {"table": "mart.daily_sales", "column": "customer_name"}, "sources": [{"table": "raw.customers", "column": "customer_name"}]},
      {"target": {"table": "mart.daily_sales", "column": "amount"}, "sources": [{"table": "raw.orders", "column": "amount"}]}
    ]
  },
  {
    "id": "s002",
    "sql": "INSERT INTO mart.monthly_totals SELECT date_trunc('month', o.order_date) AS month, sum(o.amount) FROM raw.orders o GROUP BY 1",
    "schema": ["mart.monthly_totals", "raw.orders"],
    "edges": [
