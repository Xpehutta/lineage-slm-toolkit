      {"target": {"table": "mart.monthly_totals", "column": "total"}, "sources": [{"table": "raw.orders", "column": "amount"}]}
    ]
  },
  {
    "id": "s003",
    "sql": "INSERT INTO mart.customer_profile SELECT c.customer_id, c.customer_name, a.city FROM raw.customers c JOIN raw.addresses a ON c.customer_id = a.customer_id",
