    "sql": "INSERT INTO mart.wide_target SELECT o.order_id, o.amount, c.customer_name, c.segment, a.city, a.region FROM raw.orders o JOIN raw.customers c ON o.customer_id = c.customer_id JOIN raw.addresses a ON c.customer_id = a.customer_id",
